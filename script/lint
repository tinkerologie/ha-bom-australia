#!/usr/bin/env bash
# script/lint: format, lint and type-check. Pass --check to only report.
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ "${1:-}" == "--check" ]]; then
    uv run --locked ruff format --check .
    uv run --locked ruff check .
else
    uv run --locked ruff format .
    uv run --locked ruff check --fix .
fi
uv run --locked mypy custom_components/bom_australia
